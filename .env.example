# Copy to .env. Generate secrets with:  openssl rand -hex 32
JWT_SECRET=replace-with-random-hex
TICKET_SECRET=replace-with-different-random-hex
INGEST_KEY=replace-with-random-hex
ADMIN_PASSWORD=change-this-password
POSTGRES_PASSWORD=metronav
CORS_ORIGINS=http://localhost:3000
# Simulated minutes per real minute (e.g. 10 to watch a whole peak in ~20 min)
SIM_SPEED=1
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WS_URL=ws://localhost:8080/api/v1/realtime
